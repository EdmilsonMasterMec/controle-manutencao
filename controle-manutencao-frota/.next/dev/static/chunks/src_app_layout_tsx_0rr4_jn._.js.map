"use client";

import './globals.css'
import Link from 'next/link'

export default function RootLayout({
  children,
}: {
  children: React.ReactNode
}) {
  return (
    <html lang="pt-BR">
      <body>
        <div style={{ display: "flex", minHeight: "100vh", background: "#0b0f19" }}>
          {/* Menu Lateral Estilo Balões Flutuantes */}
          <aside style={{ width: "260px", background: "#111827", borderRight: "1px solid rgba(255,255,255,0.08)", padding: "24px 20px", display: "flex", flexDirection: "column", gap: "24px", boxShadow: "4px 0 24px rgba(0,0,0,0.3)" }}>
            <div style={{ background: "rgba(255, 176, 0, 0.05)", padding: "16px", borderRadius: "14px", border: "1px solid rgba(255, 176, 0, 0.2)" }}>
              <h2 style={{ color: "#ffb000", fontSize: "18px", marginBottom: "4px", fontWeight: "700" }}>⚙️ Robert Engenharia</h2>
              <p style={{ color: "#9ca3af", fontSize: "11px", textTransform: "uppercase", letterSpacing: "0.5px" }}>Gestão de Manutenção</p>
            </div>

            <nav style={{ display: "flex", flexDirection: "column", gap: "10px" }}>
              <Link href="/" style={{ color: "#e5e7eb", textDecoration: "none", padding: "12px 16px", borderRadius: "10px", background: "rgba(255,255,255,0.03)", display: "flex", alignItems: "center", gap: "10px", fontWeight: "500" }}>
                📊 Visão Geral
              </Link>
              <Link href="/maquinas" style={{ color: "#e5e7eb", textDecoration: "none", padding: "12px 16px", borderRadius: "10px", background: "rgba(255,255,255,0.03)", display: "flex", alignItems: "center", gap: "10px", fontWeight: "500" }}>
                🚜 Equipamentos
              </Link>
              <Link href="/manutencao" style={{ color: "#e5e7eb", textDecoration: "none", padding: "12px 16px", borderRadius: "10px", background: "rgba(255,255,255,0.03)", display: "flex", alignItems: "center", gap: "10px", fontWeight: "500" }}>
                🔧 Manutenção
              </Link>
              <Link href="/mecanicos" style={{ color: "#e5e7eb", textDecoration: "none", padding: "12px 16px", borderRadius: "10px", background: "rgba(255,255,255,0.03)", display: "flex", alignItems: "center", gap: "10px", fontWeight: "500" }}>
                👨‍🔧 Equipe Técnica
              </Link>
              <Link href="/relatorios" style={{ color: "#e5e7eb", textDecoration: "none", padding: "12px 16px", borderRadius: "10px", background: "rgba(255,255,255,0.03)", display: "flex", alignItems: "center", gap: "10px", fontWeight: "500" }}>
                📈 Relatórios
              </Link>
            </nav>
          </aside>

          {/* Conteúdo com Estrutura de Balões Flutuantes */}
          <main style={{ flex: 1, overflowY: "auto", padding: "30px" }}>
            {children}
          </main>
        </div>
      </body>
    </html>
  )
}