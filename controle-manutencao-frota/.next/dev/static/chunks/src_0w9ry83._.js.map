"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { supabase } from "@/lib/supabase";

type Tecnico = {
  id: number;
  nome: string;
  especialidade: string;
  telefone: string;
  status: string;
};

export default function MecanicosPage() {
  const [tecnicos, setTecnicos] = useState<Tecnico[]>([]);
  const [mostrarCadastro, setMostrarCadastro] = useState(false);
  const [nome, setNome] = useState("");
  const [especialidade, setEspecialidade] = useState("");
  const [telefone, setTelefone] = useState("");
  const [status, setStatus] = useState("Disponível");

  async function carregarTecnicos() {
    const { data, error } = await supabase.from("mecanicos").select("*").order("id", { ascending: true });
    if (error) {
      console.error("Erro ao buscar técnicos:", error.message);
    } else if (data) {
      setTecnicos(data);
    }
  }

  useEffect(() => {
    carregarTecnicos();
  }, []);

  async function salvarTecnico(e: React.FormEvent) {
    e.preventDefault();
    if (!nome) {
      alert("Preencha o nome do técnico responsável.");
      return;
    }

    const { error } = await supabase.from("mecanicos").insert([
      { nome, especialidade, telefone, status }
    ]);

    if (error) {
      alert("Erro ao cadastrar: " + error.message);
    } else {
      alert("Técnico Responsável cadastrado com sucesso!");
      setNome("");
      setEspecialidade("");
      setTelefone("");
      setStatus("Disponível");
      setMostrarCadastro(false);
      carregarTecnicos();
    }
  }

  async function alternarStatus(id: number, statusAtual: string) {
    const novoStatus = statusAtual === "Disponível" ? "Em Serviço" : "Disponível";
    const { error } = await supabase.from("mecanicos").update({ status: novoStatus }).eq("id", id);
    if (!error) carregarTecnicos();
  }

  async function excluirTecnico(id: number) {
    if (!confirm("Deseja realmente excluir este técnico responsável?")) return;
    const { error } = await supabase.from("mecanicos").delete().eq("id", id);
    if (!error) carregarTecnicos();
  }

  return (
    <div style={{ maxWidth: "1200px", margin: "0 auto", display: "flex", flexDirection: "column", gap: "24px" }}>
      
      {/* Balão Flutuante de Cabeçalho */}
      <div style={{ background: "#111827", padding: "24px 30px", borderRadius: "16px", border: "1px solid rgba(255,255,255,0.06)", boxShadow: "0 10px 30px rgba(0,0,0,0.3)", display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: "15px" }}>
        <div>
          <h1 style={{ color: "white", fontSize: "24px", fontWeight: "700", marginBottom: "6px" }}>👨‍🔧 Equipe Técnica</h1>
          <p style={{ color: "#9ca3af", fontSize: "14px" }}>Gerenciamento da equipe técnica e profissionais</p>
        </div>
        <button
          onClick={() => setMostrarCadastro(!mostrarCadastro)}
          style={{ background: "#ffb000", color: "#111827", padding: "10px 20px", borderRadius: "10px", fontWeight: "600", border: "none", cursor: "pointer", boxShadow: "0 4px 12px rgba(255, 176, 0, 0.3)" }}
        >
          {mostrarCadastro ? "Cancelar" : "+ Novo Técnico Responsável"}
        </button>
      </div>

      {/* Formulário de Cadastro Flutuante */}
      {mostrarCadastro && (
        <div style={{ background: "#111827", padding: "24px 30px", borderRadius: "16px", border: "1px solid rgba(255,255,255,0.06)", boxShadow: "0 10px 30px rgba(0,0,0,0.3)" }}>
          <h2 style={{ color: "#ffb000", fontSize: "18px", fontWeight: "600", marginBottom: "20px" }}>Cadastrar Novo Técnico Responsável</h2>
          <form onSubmit={salvarTecnico} style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: "15px" }}>
            <input
              type="text"
              placeholder="Nome do Técnico"
              value={nome}
              onChange={(e) => setNome(e.target.value)}
              required
              style={{ padding: "12px", background: "#0b0f19", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "8px", color: "white" }}
            />
            <input
              type="text"
              placeholder="Especialidade (Ex: Hidráulica / Elétrica)"
              value={especialidade}
              onChange={(e) => setEspecialidade(e.target.value)}
              style={{ padding: "12px", background: "#0b0f19", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "8px", color: "white" }}
            />
            <input
              type="text"
              placeholder="Telefone / Contato"
              value={telefone}
              onChange={(e) => setTelefone(e.target.value)}
              style={{ padding: "12px", background: "#0b0f19", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "8px", color: "white" }}
            />
            <select
              value={status}
              onChange={(e) => setStatus(e.target.value)}
              style={{ padding: "12px", background: "#0b0f19", border: "1px solid rgba(255,255,255,0.1)", borderRadius: "8px", color: "white" }}
            >
              <option value="Disponível">Disponível</option>
              <option value="Em Serviço">Em Serviço</option>
            </select>
            <div style={{ gridColumn: "1 / -1", display: "flex", justifyContent: "flex-end", gap: "10px", marginTop: "10px" }}>
              <button type="submit" style={{ background: "#ffb000", color: "#111827", padding: "10px 20px", borderRadius: "8px", fontWeight: "600", border: "none", cursor: "pointer" }}>
                Salvar Técnico
              </button>
            </div>
          </form>
        </div>
      )}

      {/* Grid de Técnicos em Balões Flutuantes */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))", gap: "20px" }}>
        {tecnicos.map((tec) => (
          <div key={tec.id} style={{ background: "#111827", padding: "24px", borderRadius: "16px", border: "1px solid rgba(255,255,255,0.06)", boxShadow: "0 10px 30px rgba(0,0,0,0.3)", display: "flex", flexDirection: "column", gap: "15px" }}>
            <div>
              <h3 style={{ color: "white", fontSize: "18px", fontWeight: "600", marginBottom: "4px" }}>👨‍🔧 {tec.nome}</h3>
              <p style={{ color: "#9ca3af", fontSize: "13px" }}>{tec.especialidade || "Especialidade não informada"}</p>
            </div>
            
            <div style={{ fontSize: "14px", color: "#e5e7eb" }}>
              📞 {tec.telefone || "Sem telefone cadastrado"}
            </div>

            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: "10px", paddingTop: "15px", borderTop: "1px solid rgba(255,255,255,0.06)" }}>
              <span style={{
                padding: "4px 10px",
                borderRadius: "20px",
                fontSize: "12px",
                fontWeight: "500",
                background: tec.status === "Disponível" ? "rgba(74, 222, 128, 0.1)" : "rgba(250, 204, 21, 0.1)",
                color: tec.status === "Disponível" ? "#4ade80" : "#facc15",
                border: `1px solid ${tec.status === "Disponível" ? "rgba(74, 222, 128, 0.3)" : "rgba(250, 204, 21, 0.3)"}`
              }}>
                Status: {tec.status}
              </span>

              <div style={{ display: "flex", gap: "8px" }}>
                <button
                  onClick={() => alternarStatus(tec.id, tec.status)}
                  title="Alterar Status"
                  style={{ background: "rgba(255,255,255,0.05)", border: "1px solid rgba(255,255,255,0.1)", color: "white", padding: "6px 10px", borderRadius: "6px", cursor: "pointer", fontSize: "12px" }}
                >
                  🔄 Status
                </button>
                <button
                  onClick={() => excluirTecnico(tec.id)}
                  title="Excluir Técnico"
                  style={{ background: "rgba(255, 119, 119, 0.1)", border: "1px solid rgba(255, 119, 119, 0.3)", color: "#ff7777", padding: "6px 10px", borderRadius: "6px", cursor: "pointer", fontSize: "12px" }}
                >
                  🗑
                </button>
              </div>
            </div>
          </div>
        ))}
        {tecnicos.length === 0 && (
          <div style={{ gridColumn: "1 / -1", background: "#111827", padding: "40px", borderRadius: "16px", textAlign: "center", color: "#9ca3af", border: "1px solid rgba(255,255,255,0.06)" }}>
            Nenhum técnico responsável cadastrado.
          </div>
        )}
      </div>

    </div>
  );
}